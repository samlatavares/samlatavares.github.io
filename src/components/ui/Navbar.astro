---
import { Image } from 'astro:assets'
import {profile} from '../../settings'
import SocialIcons from './SocialIcons.astro'
import ProfilePictures from '@/assets/profile_pictures.jpg'
import { getLang, getPath, ui } from '@/i18n'

const lang = getLang(Astro.url)
const t = ui[lang]
const {fullName} = profile
---
<aside
	class='px-4 pt-4 h-screen w-[20rem] bg-base-200 text-base-content flex flex-col'
>
	<div class='flex flex-col my-8 justify-between h-full'>
		<div>
			<div class='flex justify-center items-center flex-col'>
				<Image
					class='mask mask-circle size-44'
					src={ProfilePictures}
					alt={`${t.photoOf} ${fullName}`}
				/>
				<p class="text-lg font-black mt-8 hidden lg:block">{fullName}</p>
			</div>
			<div class='mx-4 mt-16'>
				<ul class='space-y-4 menu grow shrink menu-md overflow-y-auto'>
					<li>
						<a href={getPath(lang, 'home')} class='text-lg'>{t.navHome}</a>
					</li>
					<li>
						<a href={getPath(lang, 'projects')} class='text-lg'>{t.navProjects}</a>
					</li>
					<li>
						<a href={getPath(lang, 'publications')} class='text-lg'>{t.navPublications}</a>
					</li>
					<li>
						<a href={getPath(lang, 'cv')} class='text-lg'>{t.navCv}</a>
					</li>
				</ul>
			</div>
		</div>
		<div class='mx-4'>
			<SocialIcons/>
		</div>
	</div>
</aside>
