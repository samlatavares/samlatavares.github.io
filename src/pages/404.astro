---
import Layout from '@/layouts/Layout.astro'
import { template } from '@/settings'
---

<Layout title="404 - Página não encontrada">
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center">
    <h1 class="text-9xl font-black text-base-content mb-4">404</h1>
    <h2 class="text-4xl font-bold text-base-content mb-8">Página não encontrada</h2>
      <p class="text-lg text-base-content/80 mb-8">
        Esta página não existe ou mudou de endereço.
      </p>
    <div class="flex gap-4">
      <a
        href={`${template.base}/`}
        class="btn btn-primary text-primary-content"
      >
        Ir para o início
      </a>
      <button
        class="btn btn-outline btn-accent"
        onclick="history.back()"
      >
        Voltar
      </button>
    </div>
  </div>
</Layout>
